# Every setting starter/runtime/config.py reads, at its local default: copying this file changes
# nothing. tests/test_env_example.py fails when this list and config.py drift apart.
# Cloud values are set by scripts/deploy.sh and Secret Manager (docs/deploy.md), not from this file.

# local runs offline with no keys; cloud refuses to start without ANTHROPIC_API_KEY and ADMIN_PASSWORD
MODE=local
# a file path, or gs://bucket/object (deploy.sh sets the bucket in cloud)
DATA_PATH=data/store.json
# json keeps state at DATA_PATH; surreal uses the SURREAL_* settings below
STORE=json
# mem:// is embedded in-process; ws(s)://host/rpc for a server
SURREAL_URL=mem://
# SurrealDB namespace
SURREAL_NS=starter
# SurrealDB database
SURREAL_DB=starter
# SurrealDB user; empty for mem://, required with STORE=surreal in cloud
SURREAL_USER=
# SurrealDB password; empty for mem://, required with STORE=surreal in cloud
SURREAL_PASS=
# the login password; a real one comes from the admin-password secret in cloud
ADMIN_PASSWORD=admin
# empty uses the fake provider, offline; a real key makes model calls that cost money
ANTHROPIC_API_KEY=
# the Claude model the agent calls
MODEL=claude-opus-5-5
# simulate or live; only live lets effect tools act
EFFECTS=simulate
# low, medium, high, xhigh or max
EFFORT=medium
# seconds per case; must exceed twice MODEL_TIMEOUT_S
CASE_TIMEOUT_S=120
# seconds per model call
MODEL_TIMEOUT_S=50
# model calls per case
MAX_ITERATIONS=8
# send_email through Resend; empty simulates, and EFFECTS=live without it fails (503)
RESEND_API_KEY=
# the sender, on a domain verified in Resend, e.g. Team <team@example.com>
EMAIL_FROM=
# place_call through an ElevenLabs agent; empty simulates, and EFFECTS=live without it fails (503)
ELEVENLABS_API_KEY=
# the ElevenLabs agent that makes the call
ELEVENLABS_AGENT_ID=
# the ElevenLabs phone number id (a Twilio number imported into ElevenLabs) it calls from
ELEVENLABS_PHONE_NUMBER_ID=
# low-high seconds each simulated effect waits; set only by scripts/demo/record.py, never here
DEMO_LATENCY=
